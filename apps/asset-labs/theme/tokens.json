{
  "app": "asset-labs",
  "source": "app/static/app.css (dépôt de l'appli)",
  "default": "clair, ou sombre selon le système",
  "storage_key": "pcs-theme",
  "themes": {
    "clair": {
      "--bg": "#f6f6f8",
      "--surface": "#ffffff",
      "--sunken": "#efeff2",
      "--line": "#e4e5ea",
      "--line-strong": "#d1d3da",
      "--text": "#18191d",
      "--muted": "#5d616b",
      "--faint": "#676b75",
      "--hover": "rgba(24, 25, 29, .05)",
      "--press": "rgba(24, 25, 29, .08)",
      "--accent": "#e5a00d",
      "--on-accent": "#1d1404",
      "--accent-text": "#8a5c00",
      "--focus": "#a87000",
      "--accent-soft": "#fdf1d4",
      "--accent-line": "#efcf89",
      "--assets": "#3f55c9",
      "--assets-soft": "#e8ebfb",
      "--assets-line": "#c2c9f2",
      "--media": "#0b6e63",
      "--media-soft": "#ddf0ea",
      "--media-line": "#a3d1c7",
      "--ok": "#1b7a45",
      "--ok-soft": "#e1f3e8",
      "--warn": "#9c4a1c",
      "--warn-soft": "#fbeade",
      "--warn-line": "#ecc3a8",
      "--bad": "#b8283f",
      "--bad-soft": "#fbe3e7",
      "--on-bad": "#ffffff",
      "--stage": "#2a2c33",
      "--canvas": "#e8e9ed",
      "--glass": "rgba(255, 255, 255, .74)",
      "--glass-line": "rgba(24, 25, 29, .09)",
      "--backdrop-strength": ".42",
      "--veil": "var(--bg)",
      "--shadow": "0 1px 2px rgba(20, 22, 30, .06)",
      "--lift": "0 0.75rem 1.625rem -0.875rem rgba(20, 22, 30, .38)",
      "--pop": "0 1.125rem 2.5rem -1rem rgba(20, 22, 30, .45)",
      "--r-lg": "0.875rem",
      "--r": "0.625rem",
      "--r-sm": "0.5rem",
      "--pill": "0.5rem",
      "--pill-s": "0.375rem",
      "--nav-w": "15.5rem",
      "--topbar-h": "3.5rem",
      "--t-xs": "0.75rem",
      "--t-sm": "0.8125rem",
      "--t-md": "0.875rem",
      "--t-lg": "1rem",
      "--t-xl": "1.25rem",
      "--t-2xl": "1.75rem",
      "--font": "\"Figtree Variable\", \"Figtree\", -apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "--mono": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SF Mono\", \"Cascadia Mono\", Menlo, Consolas, monospace",
      "--brand": "#8a5c00"
    },
    "sombre": {
      "inherits": "clair",
      "overrides": {
        "--bg": "#1d1e22",
        "--surface": "#26272c",
        "--sunken": "#2e2f35",
        "--line": "#34363d",
        "--line-strong": "#474a52",
        "--text": "#f1f1f3",
        "--muted": "#a9acb5",
        "--faint": "#9295a0",
        "--hover": "rgba(255, 255, 255, .06)",
        "--press": "rgba(255, 255, 255, .1)",
        "--accent-text": "#f0b53a",
        "--focus": "#e5a00d",
        "--accent-soft": "#3a2f17",
        "--accent-line": "#6b5216",
        "--assets": "#9eaaf6",
        "--assets-soft": "#2a2f4f",
        "--assets-line": "#3f4782",
        "--media": "#6fd0c0",
        "--media-soft": "#17322f",
        "--media-line": "#1f5a51",
        "--ok": "#62d396",
        "--ok-soft": "#1c3527",
        "--warn": "#e07a5f",
        "--warn-soft": "#3b2619",
        "--warn-line": "#6b3c22",
        "--bad": "#ff7a8c",
        "--bar-bad": "#ffa3b1",
        "--bad-soft": "#3d2128",
        "--on-bad": "#2a0c12",
        "--stage": "#141518",
        "--canvas": "#17181b",
        "--glass": "rgba(38, 39, 44, .72)",
        "--glass-line": "rgba(255, 255, 255, .1)",
        "--backdrop-strength": ".6",
        "--shadow": "0 1px 2px rgba(0, 0, 0, .35)",
        "--lift": "0 0.875rem 1.875rem -0.875rem rgba(0, 0, 0, .8)",
        "--pop": "0 1.25rem 2.75rem -1rem rgba(0, 0, 0, .85)",
        "--brand": "#f2b84b"
      }
    }
  }
}
