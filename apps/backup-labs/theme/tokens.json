{
  "app": "backup-labs",
  "source": "web/src/lib/styles.css (dépôt de l'appli)",
  "style": "Console",
  "default": "automatique : sombre ou clair selon le système",
  "attribute": "data-mode sur <html> : light ou dark ; absent = automatique",
  "storage_key": "backuplabs.mode",
  "modes": {
    "sombre": {
      "--bg": "#080b0f",
      "--surface": "#10171e",
      "--surface-2": "#18222c",
      "--text": "#e6edf3",
      "--strong": "#ffffff",
      "--muted": "#a9b6c3",
      "--faint": "#8796a5",
      "--line": "#222f3c",
      "--line-strong": "#364859",
      "--accent": "#7ee2a8",
      "--accent-text": "#06130b",
      "--link": "#7ee2a8",
      "--selection": "rgb(126 226 168 / 0.28)",
      "--nav-bg": "#0b1116",
      "--nav-text": "#a9b6c3",
      "--nav-active-bg": "#1b2733",
      "--nav-active-text": "#ffffff",
      "--ok": "#86f0b4",
      "--ok-bar": "#3ccf86",
      "--warn": "#ffc457",
      "--warn-bar": "#ffc457",
      "--fail": "#ff8a80",
      "--fail-bar": "#ff7b70",
      "--busy": "#9cc3ff",
      "--idle": "#222f3c",
      "--ok-soft": "#0e2a1c",
      "--warn-soft": "#2c220f",
      "--fail-soft": "#331515",
      "--busy-soft": "#121f37"
    },
    "clair": {
      "--bg": "#f2f4f6",
      "--surface": "#ffffff",
      "--surface-2": "#eceff3",
      "--text": "#18212b",
      "--strong": "#0b1117",
      "--muted": "#4a5868",
      "--faint": "#5b6979",
      "--line": "#dbe1e7",
      "--line-strong": "#b4bec9",
      "--accent": "#13784a",
      "--accent-text": "#ffffff",
      "--link": "#0f6b40",
      "--selection": "rgb(19 120 74 / 0.18)",
      "--nav-bg": "#e8ecf0",
      "--nav-text": "#3c4957",
      "--nav-active-bg": "#d7dee5",
      "--nav-active-text": "#0b1117",
      "--ok": "#11713f",
      "--ok-bar": "#2fa66a",
      "--warn": "#8a5300",
      "--warn-bar": "#e9a520",
      "--fail": "#b42318",
      "--fail-bar": "#dc4437",
      "--busy": "#1d4ed8",
      "--idle": "#e3e8ed",
      "--ok-soft": "#e2f3e9",
      "--warn-soft": "#fbefd6",
      "--fail-soft": "#fce6e4",
      "--busy-soft": "#e5ecfd"
    }
  },
  "commun": {
    "--font-sans": "'IBM Plex Sans', system-ui, sans-serif",
    "--font-mono": "'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace",
    "--text-sm": "0.875rem",
    "--text-base": "1rem",
    "--text-lg": "1.125rem",
    "--text-xl": "1.375rem",
    "--text-2xl": "1.75rem",
    "--radius": "8px",
    "--radius-sm": "6px"
  }
}
